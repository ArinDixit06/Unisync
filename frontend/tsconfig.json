{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "stores/**/*.ts",
    "stores/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".next", ".storybook", "src/components", "src/lib", "src/stores", "src/pages"]
}
